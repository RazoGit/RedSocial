                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Callback OAuth: canjea el code y emite la sesion (RF-9)",
        "tags": ["auth"]
      }
