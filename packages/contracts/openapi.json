    "/api/v1/auth/reset-password": {
      "post": {
        "description": "RF-12: consume el token de un solo uso, guarda la nueva contrasena hasheada (argon2id), revoca TODAS las sesiones activas del usuario y le notifica por email.",
        "operationId": "AuthController_resetPassword_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
