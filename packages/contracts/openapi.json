    "/api/v1/auth/register": {
      "post": {
        "description": "Crea la cuenta inactiva (emailVerified=false) y encola el email de verificacion (RF-1/RF-2).",
        "operationId": "AuthController_register_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  }
                },
                "required": ["email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada e inactiva; email de verificacion encolado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "email": {
                      "type": "string"
                    },
                    "emailVerified": {
                      "type": "boolean"
                    }
                  },
                  "required": ["id", "email", "emailVerified"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Payload invalido (validation_failed)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Mensaje generico identico para cualquier email ya registrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Registro local con email y contrasena",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "description": "Token de un solo uso valido 24 h; marca el email verificado e inicia sesion (RF-3): access token en cuerpo y refresh en cookie httpOnly.",
        "operationId": "AuthController_verifyEmail_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 128
                  }
                },
                "required": ["token"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verificado y sesion iniciada; Set-Cookie rt (httpOnly)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "exclusiveMinimum": true,
                      "maximum": 9007199254740991,
                      "minimum": 0
                    },
                    "csrfToken": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 128
                    }
                  },
                  "required": ["accessToken", "expiresIn", "csrfToken"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Token invalido, ya usado o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Consume un token de verificacion de email",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "RF-4: permite login aunque el email no este verificado. RF-5: tras 5 fallos por IP en 15 min responde 429 con Retry-After. Emite access token en cuerpo y refresh en cookie httpOnly (RF-6).",
        "operationId": "AuthController_login_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": ["email", "password"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesion iniciada; Set-Cookie rt (httpOnly)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "exclusiveMinimum": true,
                      "maximum": 9007199254740991,
                      "minimum": 0
                    },
                    "csrfToken": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 128
                    }
                  },
                  "required": ["accessToken", "expiresIn", "csrfToken"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Payload invalido (validation_failed)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Mensaje generico identico para email inexistente o contrasena incorrecta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "IP bloqueada temporalmente por intentos fallidos repetidos (RF-5)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Inicio de sesion local con email y contrasena",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "RF-6/RF-7/RF-8: requiere cookie rt httpOnly y header X-CSRF-Token igual al valor de la cookie csrf_token (double-submit, D6). Rota el refresh: el anterior queda invalido y reutilizarlo revoca toda la familia con 401. Expiracion deslizante 30 d con tope de 90 d.",
        "operationId": "AuthController_refresh_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sesion renovada; nuevas cookies rt y csrf_token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "exclusiveMinimum": true,
                      "maximum": 9007199254740991,
                      "minimum": 0
                    },
                    "csrfToken": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 128
                    }
                  },
                  "required": ["accessToken", "expiresIn", "csrfToken"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Cookie ausente, token invalido, expirado o reutilizado (familia revocada)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Header X-CSRF-Token ausente o distinto de la cookie csrf_token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Renueva la sesion rotando el refresh token de la cookie",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "description": "Responde 202 siempre para no enumerar cuentas; invalida enlaces anteriores sin usar. El rate limit por IP se anade con forgot-password en T14.",
        "operationId": "AuthController_resendVerification_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  }
                },
                "required": ["email"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Aceptado (con o sin cuenta asociada)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  },
                  "required": ["accepted"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Reenvia el email de verificacion",
        "tags": ["auth"]
      }
    },
