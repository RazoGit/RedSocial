                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Restablece la contrasena con el token del email",
        "tags": ["auth"]
      }
    },
