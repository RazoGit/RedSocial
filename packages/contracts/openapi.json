    "/api/v1/auth/oauth/{provider}": {
      "get": {
        "description": "RF-9: redirige a Google/GitHub con state+nonce firmados en una cookie temporal httpOnly (10 min). Requiere credenciales del proveedor via env; sin ellas responde 503.",
        "operationId": "AuthController_oauthStart_v1",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redireccion al endpoint de autorizacion del proveedor"
          },
          "400": {
            "description": "Proveedor desconocido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Credenciales OAuth ausentes en este entorno",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Inicia el flujo OAuth (authorization code) con el proveedor",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/oauth/{provider}/callback": {
      "get": {
        "description": "Verifica el state contra la cookie firmada (un solo uso), canjea code por identidad verificada del proveedor (id_token/JWKS en Google; /user+/user/emails en GitHub), vincula por email verificado o crea cuenta verificada, y ejecuta RF-6: cookies rt+csrf_token y redirect al frontend con tokens en el fragmento.",
        "operationId": "AuthController_oauthCallback_v1",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect a {APP_URL}/auth/callback#access=...&expires_in=...&csrf=...; Set-Cookie rt (httpOnly) y csrf_token"
          },
          "400": {
            "description": "Proveedor desconocido o code ausente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "State invalido/reutilizado, id_token invalido, nonce incorrecto o email sin verificar en el proveedor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  },
                  "required": ["statusCode", "message", "path", "timestamp"],
                  "additionalProperties": false
                }
              }
            }
          },
          "502": {
            "description": "El proveedor rechazo el canje o no esta disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
