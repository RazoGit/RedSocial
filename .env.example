# Copiar a .env (git lo ignora). Valores = entorno dev local (docker-compose.yml)

# API
PORT=4000
# URL del frontend para enlaces de emails (verificacion, reset)
APP_URL=http://localhost:3000

# PostgreSQL (contenedor dev)
DATABASE_URL=postgresql://redsocial:redsocial@localhost:5432/redsocial?schema=public

# Redis (contenedor dev)
REDIS_URL=redis://localhost:6379

# S3-compatible: MinIO en dev / Cloudflare R2 en prod
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=redsocial-dev

# OAuth (https://console.cloud.google.com y https://github.com/settings/developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth
JWT_SECRET=cambiar-en-dev
JWT_ACCESS_TTL=15m

# SMTP dev = Mailpit (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=dev@redsocial.local
