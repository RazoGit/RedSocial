generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.Citext
  passwordHash  String?   @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")

  // Perfil publico (spec 002)
  username          String?   @unique @db.Citext
  displayName       String?   @map("display_name")
  bio               String?
  avatarKey         String?   @map("avatar_key")
  avatarThumbKey    String?   @map("avatar_thumb_key")
  avatarBlurhash    String?   @map("avatar_blurhash")
  isPrivate         Boolean   @default(false) @map("is_private")
  usernameChangedAt DateTime? @map("username_changed_at") @db.Timestamptz(3)

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  oauthAccounts     OauthAccount[]
  sessions          Session[]
  emailTokens       EmailToken[]
  usernameHistories UsernameHistory[]

  @@map("users")
}

model OauthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, userId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  refreshHash    String    @unique @map("refresh_hash")
  userAgent      String?   @map("user_agent")
  ip             String?
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByHash String?   @map("replaced_by_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum EmailTokenType {
  verify_email
  password_reset
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  tokenHash String         @unique @map("token_hash")
  type      EmailTokenType
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

/// Historial de usernames liberados (spec 002 RF-3): el anterior queda
/// reservado hasta `released_at` (30 dias) y luego puede reutilizarse.
model UsernameHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  username   String   @db.Citext
  releasedAt DateTime @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username, releasedAt])
  @@index([userId])
  @@map("username_history")
}
